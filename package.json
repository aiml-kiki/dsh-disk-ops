{
  "name": "dsh-disk-ops",
  "version": "0.1.0",
  "description": "Visualize disk usage with a treemap and reclaim macOS caches through a reviewed plan inside DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "DESIGN.md",
    "PUBLISH.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.mjs",
    "install:plugin": "node scripts/install.mjs",
    "publish:check": "node scripts/publish.mjs",
    "publish:npm": "node scripts/publish.mjs --publish",
    "market:index": "node scripts/market-index.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "license": "MIT",
  "bin": {
    "dsh-disk": "./bin/dsh-disk.js"
  },
  "os": [
    "darwin"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "disk",
    "cleanup",
    "storage",
    "macos",
    "treemap"
  ],
  "author": "dsh-disk-ops contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiml-kiki/dsh-disk-ops.git"
  },
  "homepage": "https://github.com/aiml-kiki/dsh-disk-ops"
}
